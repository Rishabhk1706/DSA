https://leetcode.com/problems/count-values-with-equally-spaced-occurrences-i/ 12-09-26

class Solution {
    public int countSpecialIntegers(int[] nums) {
        List<Integer>[] pos = new ArrayList[101];
        for(int i=0;i<=100;i++){
            pos[i] = new ArrayList<>();
        }
        for(int i=0;i<nums.length;i++){
            pos[nums[i]].add(i);
        }
        int ans=0;
        for(int x=1;x<=100;x++){
            if(pos[x].size()==3){
                int i1 = pos[x].get(0);
                int i2 = pos[x].get(1);
                int i3 = pos[x].get(2);
                if(i2-i1 == i3-i2){
                    ans++;
                }
            }
        }
        return ans;
    }
}