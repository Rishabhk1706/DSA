https://leetcode.com/problems/smallest-divisible-digit-product-i 06-08-26

class Solution {
    public int pro(int x){
        int sum=1;
        while(x>0){
            sum *= x%10;
            x = x/10; 
        }
        return sum;
    }
    public int smallestNumber(int n, int t) {
        for(int i=n;i<=100;i++){
            if(pro(i)%t==0){
                return i;
            }
        }
        return n;
    }
}