https://leetcode.com/problems/count-good-cyclic-rotations/ 07-09-26

class Solution {
    public int countGoodRotations(int[] nums) {
        int n = nums.length;
        int half = n / 2;
        long total = 0;
        for(int x : nums){
            total += x;
        }
        long firstSum = 0;
        for(int i=0;i<half;i++){
            firstSum += nums[i];
        }
        int ans = 0;
        for(int i=0;i<n;i++){
            long lastSum = total - firstSum;
            if(firstSum>lastSum){
                ans++;
            }
            firstSum -= nums[i];
            firstSum += nums[(i + half) % n];
        }
        return ans;
    }
}