https://leetcode.com/problems/rearrange-array-elements-by-sign 07-08-26

class Solution {
    public int[] rearrangeArray(int[] nums) {
        int i=0,j=0,k=0,n=nums.length;
        int[] ans = new int[n];
        while(k<n){
            while(i<n && nums[i]<0) i++;
            ans[k++] = nums[i++];
            while(j<n && nums[j]>=0) j++;
            ans[k++] = nums[j++];
        }
        return ans;
    }
}