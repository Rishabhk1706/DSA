https://leetcode.com/problems/broken-calculator 28-10-26

class Solution {
    public int brokenCalc(int startValue, int target) {
        int c=0;
        while(startValue<target){
            if(target%2==0){
                target/=2;
            }
            else{
                target+=1;
            }
            c+=1;
        }
        return c + (startValue-target);
    }
}