https://leetcode.com/problems/maximum-sum-with-at-most-k-elements 15-08-26

class Solution {
    public long maxSum(int[][] grid, int[] limits, int k) {
        PriorityQueue<Integer> pq = new PriorityQueue<>((a,b) -> Integer.compare(a,b));
        for(int i=0;i<grid.length;i++){
            Arrays.sort(grid[i]);
            int c=0;
            for(int j=grid[i].length-1;j>=0;j--){
                if(c >= limits[i]) break;
                pq.add(grid[i][j]);
                c++;
                if(pq.size()>k) pq.poll();
            }
        }
        long sum=0;
        while(!pq.isEmpty()){
            sum+=pq.poll();
        }
        return sum;
    }
}