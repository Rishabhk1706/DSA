https://leetcode.com/problems/merge-in-between-linked-lists 17-10-26

class Solution {
    public ListNode mergeInBetween(ListNode list1, int a, int b, ListNode list2) {
        ListNode ptr2=list2;
        while(ptr2.next!=null){
            ptr2=ptr2.next;
        }
        ListNode ptr=list1;
        int c=1;
        ListNode prev=null;
        while(ptr!=null){
            if(c==a){
                prev=ptr;
            }
            if(c==(b+1)){
                ptr=ptr.next;
                break;
            }
            ptr=ptr.next;
            c++;
        }
        prev.next=list2;
        ptr2.next=ptr;
        return list1;
    }
}