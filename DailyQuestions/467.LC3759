https://leetcode.com/problems/count-elements-with-at-least-k-greater-values 14-11-26

class Solution {
    public int countElements(int[] nums, int k) {
        int n= nums.length;
        Arrays.sort(nums);
        int x=0;
        int c=0;
        while(x<n){
            int j=x+1;
            while(j<n && nums[j]==nums[x]){
                j++;
            }
            j--;
            int dup = j-x+1;
            x=j;
            int avail = n-x-1;
            if(avail>=k){
                c+=dup;
            }
            x++;
        }
        return c;
    }
}