https://leetcode.com/problems/maximum-number-of-coins-you-can-get/ 30-10-26

class Solution {
    public int maxCoins(int[] piles) {
        int n=0, j=2;
        Arrays.sort(piles);
        for(int i=0;i<piles.length/3;i++){
            n+=piles[piles.length-j];
            j=j+2;
        }
        return n;
    }
}