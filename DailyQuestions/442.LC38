https://leetcode.com/problems/count-and-say 18-10-26

class Solution {
    public String countAndSay(int n) {
        String s = "1";
        for(int k=0;k<n-1;k++){
            int i = 0;
            StringBuilder t = new StringBuilder();
            while(i<s.length()){
                int j = i;
                while(j<s.length() && s.charAt(j)==s.charAt(i)){
                    j++;
                }
                t.append(j-i);
                t.append(s.charAt(i));
                i = j;
            }
            s = t.toString();
        }
        return s;
    }
}