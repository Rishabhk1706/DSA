https://leetcode.com/problems/max-chunks-to-make-sorted/ 15-10-26

class Solution {
    public int maxChunksToSorted(int[] arr) {
        int[] sorted = arr.clone();
        Arrays.sort(arr);
        int count=0;
        int max1=0;
        int max2=0;
        for(int i=0;i<arr.length;i++){
            if(max1<arr[i]) max1=arr[i];
            if(max2<sorted[i]) max2=sorted[i];
            if(max1==max2) count++;
        }
        return count;
    }
}