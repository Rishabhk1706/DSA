https://leetcode.com/problems/find-missing-elements/ 04-08-26

class Solution {
    public List<Integer> findMissingElements(int[] nums) {
        boolean[] a = new boolean[101];
        int mini=101,maxi=0;
        for(int j : nums){
            mini = Math.min(mini,j);
            maxi = Math.max(maxi,j);
            a[j] = true;
        }
        List<Integer> al = new ArrayList<>();
        for(int i=mini;i<=maxi;i++){
            if(!a[i]) al.add(i);
        }
        return al;
    }
}