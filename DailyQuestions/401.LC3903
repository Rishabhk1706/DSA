https://leetcode.com/problems/smallest-stable-index-i 04-09-26

class Solution {
    public int firstStableIndex(int[] nums, int k) {
        int n = nums.length;
        int[] maxi = new int[n];
        maxi[0] = nums[0];
        int[] mini = new int[n];
        mini[n-1] = nums[n-1];
        for(int i=1;i<n;i++){
            maxi[i] = Math.max(maxi[i-1],nums[i]);
        }
        for(int i=n-2;i>=0;i--){
            mini[i] = Math.min(mini[i+1],nums[i]);
        }
        for(int i=0;i<n;i++){
            int s = maxi[i] - mini[i];
            if(s<=k){
                return i;
            }
        }
        return -1;
    }
}