https://leetcode.com/problems/minimum-size-subarray-sum 05-08-26

class Solution {
    public int minSubArrayLen(int target, int[] nums) {
        int l=0,r=0,size=Integer.MAX_VALUE;
        long sum=0;
        while(r<nums.length){
            sum+=nums[r];
            while(l<=r && sum>=target){
                size = Math.min(size,r-l+1);
                sum-=nums[l++];
            }
            r++;
        }
        return size==Integer.MAX_VALUE ? 0 : size;
    }
}