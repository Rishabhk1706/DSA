https://leetcode.com/problems/distribute-elements-into-two-arrays-i 20-08-26

class Solution {
    public int[] resultArray(int[] nums) {
        int n = nums.length;
        int[] arr = new int[n];
        int i=0,j=n-1;
        arr[i] = nums[0];
        arr[j] = nums[1];
        for(int k=2;k<n;k++){
            if(arr[i]>arr[j]){
                arr[++i]=nums[k];
            }
            else{
                arr[--j]=nums[k];
            }
        }
        i=n-1;
        while(j<i){
            int temp = arr[j];
            arr[j] = arr[i];
            arr[i] = temp;
            i--;
            j++;
        }
        return arr;
    }
}