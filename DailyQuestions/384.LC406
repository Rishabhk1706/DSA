https://leetcode.com/problems/queue-reconstruction-by-height 17-08-26

class Solution {
    public int[][] reconstructQueue(int[][] people) {
        Arrays.sort(people,(a,b) -> {
            if(a[0]!=b[0]){
                return b[0] - a[0];
            }
            return a[1] - b[1];
        });
        List<int[]> q = new ArrayList<>();
        for(int[] p : people){
            q.add(p[1], p);
        }
        return q.toArray(new int[people.length][]);
    }
}