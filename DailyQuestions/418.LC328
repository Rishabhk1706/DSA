https://leetcode.com/problems/odd-even-linked-list 22-09-26

class Solution {
    public ListNode oddEvenList(ListNode head) {
        if(head==null){
            return null;
        }
        if(head.next==null || head.next.next==null){
            return head;
        }
        ListNode ptr=head;
        int c=1;
        while(ptr.next!=null){
            c++;
            ptr=ptr.next;
        }
        ListNode prev=null;
        ListNode tail=head;
        for(int i=1;i<=c;i++){
            if(i%2==0){
                prev.next=tail.next;
                ptr.next=tail;
                tail=tail.next;
                ptr=ptr.next;
                ptr.next=null;
            }
            else{
                prev=tail;
                tail=tail.next;
            }
        }
        return head;
    }
}