https://leetcode.com/problems/the-number-of-weak-characters-in-the-game 17-09-26

class Solution {
    public int numberOfWeakCharacters(int[][] properties) {
        Arrays.sort(properties,(a, b) -> {
            if(a[0]==b[0]) return a[1]-b[1]; // ascending defense if same attack
            return b[0]-a[0];// descending attack 
        });
        int count=0;
        int maxdef=0;
        for(int[] p : properties){
            if(p[1]<maxdef){
                count++;
            }
            else{
                maxdef=p[1];
            }
        }
        return count;
    }
}