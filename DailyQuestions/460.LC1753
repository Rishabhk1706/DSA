https://leetcode.com/problems/maximum-score-from-removing-stones 06-11-26

class Solution {
    public int maximumScore(int a, int b, int c) {
        int[] s = {a, b, c};
        Arrays.sort(s);
        int ans = 0;
        while(s[1]>0){
            ans += 1;
            s[1] -= 1;
            s[2] -= 1;
            Arrays.sort(s);
        }
        return ans;
    }
}