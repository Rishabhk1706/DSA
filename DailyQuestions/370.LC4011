https://leetcode.com/problems/count-subarrays-with-even-odd-ratio-i/ 03-08-26

class Solution {
    public int countRatioSubarrays(int[] nums, int a, int b) {
        int cnt=0,n=nums.length;
        for(int i=0;i<n;i++){
            int odd=0,even=0;
            for(int j=i;j<n;j++){
                if(nums[j]%2==0) even++;
                else odd++;
                if(odd>0 && even*b <= a*odd){
                    cnt++;
                }
            }
        }
        return cnt;
    }
}