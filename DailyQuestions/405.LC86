https://leetcode.com/problems/partition-list/ 08-09-26

class Solution {
    public ListNode partition(ListNode head, int x) {
        
        ListNode first = new ListNode(0);
        ListNode second = new ListNode(0);
        ListNode ptr1=first;
        ListNode ptr2=second;
        while(head!=null){
            if(head.val<x){
                ptr1.next=head;
                ptr1=ptr1.next;
            }
            else{
                ptr2.next=head;
                ptr2=ptr2.next;
            }
            head=head.next;
        }
        ptr1.next=second.next;
        ptr2.next=null;
        return first.next;
    }
}