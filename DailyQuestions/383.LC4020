https://leetcode.com/problems/elevator-requests-i/description/ 16-08-26

class Solution {
    public int elevatorRequests(int n, int[] requests) {
        int ans=0;
        for(int i=0;i<requests.length;i++){
            if(i==0) ans+=requests[i];
            else ans+=Math.abs(requests[i]-requests[i-1]);
        }
        return ans;
    }
}