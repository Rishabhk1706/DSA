https://leetcode.com/problems/maximum-alternating-sum-of-squares 13-10-26

class Solution {
    public long maxAlternatingSum(int[] nums) {
        int n = nums.length;
        PriorityQueue<Integer> pq = new PriorityQueue<>((a,b) -> Integer.compare(b,a));
        for(int j : nums){
            if(j<0) pq.add(-j);
            else pq.add(j);
        }
        long maxi = 0;
        long mini = 0;
        int c=0;
        while(!pq.isEmpty()){
            int bal = pq.poll();
            if(c<((n+1)/2)) maxi += bal*bal;
            else mini += bal*bal;
            c++;
        }
        return maxi-mini;
    }
}